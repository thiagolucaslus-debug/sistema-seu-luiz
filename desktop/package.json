{
  "name": "administracao-financeira-desktop",
  "version": "2.1.0",
  "description": "Administração Financeira — Aplicativo Desktop Nativo (Electron + Python Integrado + Sincronização Nuvem/Celular)",
  "author": "Administração Financeira",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.administracaofinanceira.desktop",
    "productName": "Administracao Financeira",
    "asar": true,
    "asarUnpack": [
      "icon.ico",
      "icon.png"
    ],
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "icon.ico",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "portable_runtime/python_runtime",
        "to": "python_runtime"
      },
      {
        "from": "portable_runtime/nodejs",
        "to": "nodejs"
      },
      {
        "from": "app_engine_clean",
        "to": "app_engine"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico",
      "executableName": "Administracao Financeira"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Administração Financeira",
      "artifactName": "Administracao_Financeira_Setup.exe",
      "deleteAppDataOnUninstall": false,
      "include": "installer.nsh"
    }
  }
}
