# Dependencies
node_modules/
frontend/node_modules/
whatsapp-service/node_modules/

# Python cache
__pycache__/
backend/__pycache__/
backend/routers/__pycache__/
backend/services/__pycache__/
*.py[cod]
.pytest_cache/

# Binaries & downloads
bin/
*.exe
*.zip

# WhatsApp session cache
whatsapp-service/.wwebjs_auth/
whatsapp-service/.wwebjs_cache/

